<UserControl x:Class="EducationCenterSystem.Presentation.Views.RegisterStudentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:EducationCenterSystem.Presentation.ViewModels"
             xmlns:components="clr-namespace:EducationCenterSystem.Presentation.Views.Components"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:RegisterStudentViewModel}"
             Background="#F0F2F5" FlowDirection="RightToLeft"
             d:DesignHeight="500" d:DesignWidth="400">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="20">
        <Border Background="White" CornerRadius="12" Padding="40" MaxWidth="900" VerticalAlignment="Top" BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.05"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="{Binding FormTitle}" FontSize="26" FontWeight="Bold" Margin="0,0,0,30" Foreground="#1A365D" HorizontalAlignment="Center"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- الصف 0 -->
                    <components:FormFieldComponent Grid.Row="0" Grid.Column="0" LabelText="كود الطالب *" Text="{Binding StudentCode, UpdateSourceTrigger=PropertyChanged}" />
                    <components:FormFieldComponent Grid.Row="0" Grid.Column="2" LabelText="الرقم القومي" Text="{Binding NationalId, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- الصف 1 -->
                    <components:FormFieldComponent Grid.Row="1" Grid.Column="0" LabelText="الاسم الأول *" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
                    <components:FormFieldComponent Grid.Row="1" Grid.Column="2" LabelText="الاسم الأخير *" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- الصف 2 -->
                    <components:FormFieldComponent Grid.Row="2" Grid.Column="0" LabelText="رقم الهاتف *" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" />
                    <components:FormFieldComponent Grid.Row="2" Grid.Column="2" LabelText="رقم هاتف ولي الأمر *" Text="{Binding ParentPhoneNumber, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- الصف 3 -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,15">
                        <TextBlock Text="تاريخ الميلاد *" Margin="0,0,0,8" FontWeight="SemiBold" Foreground="#4A5568"/>
                        <DatePicker SelectedDate="{Binding DateOfBirth, UpdateSourceTrigger=PropertyChanged}" Height="40" FontSize="14" BorderBrush="#CBD5E0"/>
                    </StackPanel>
                    <components:FormFieldComponent Grid.Row="3" Grid.Column="2" LabelText="البريد الإلكتروني *" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- الصف 4 -->
                    <components:FormFieldComponent Grid.Row="4" Grid.Column="0" LabelText="المرحلة الدراسية *" Text="{Binding GradeLevel, UpdateSourceTrigger=PropertyChanged}" />
                    <components:FormFieldComponent Grid.Row="4" Grid.Column="2" LabelText="المدرسة" Text="{Binding SchoolName, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- الصف 5 -->
                    <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,0,15">
                        <TextBlock Text="النوع *" Margin="0,0,0,8" FontWeight="SemiBold" Foreground="#4A5568"/>
                        <ComboBox SelectedItem="{Binding Gender}" Height="40" FontSize="14" BorderBrush="#CBD5E0" SelectedIndex="0">
                            <!-- Binding explicitly to strings, we'll let the viewmodel convert or we can just pass strings. Actually, since Gender is an enum, WPF converts string to enum automatically for SelectedItem. -->
                            <ComboBoxItem Content="Male"/>
                            <ComboBoxItem Content="Female"/>
                        </ComboBox>
                    </StackPanel>
                    <components:FormFieldComponent Grid.Row="5" Grid.Column="2" LabelText="العنوان" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- الصف 6 -->
                    <components:FormFieldComponent Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" LabelText="ملاحظات" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <components:PrimaryButtonComponent Text="حفظ بيانات الطالب" Command="{Binding RegisterCommand}" Width="200" />
                </StackPanel>

                <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="4" Margin="0,15,0,0" 
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Foreground="#3182CE" Background="Transparent"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
