<UserControl x:Class="EducationCenterSystem.Presentation.Views.Components.PrimaryButtonComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <Button Command="{Binding ElementName=Root, Path=Command}" 
                Content="{Binding ElementName=Root, Path=Text}" 
                Height="40" Background="#38A169" Foreground="White" 
                FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="5"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</UserControl>
