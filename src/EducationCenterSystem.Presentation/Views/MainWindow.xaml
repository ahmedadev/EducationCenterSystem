<Window x:Class="EducationCenterSystem.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EducationCenterSystem.Presentation.ViewModels"
        xmlns:v="clr-namespace:EducationCenterSystem.Presentation.Views"
        Title="منظومة إدارة المركز التعليمي | Education Center Suite" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    
    <Window.Resources>
        <!-- ViewModel to View Mapping -->
        <DataTemplate DataType="{x:Type vm:RegisterStudentViewModel}">
            <v:RegisterStudentView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StudentsListViewModel}">
            <v:StudentsListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegisterTeacherViewModel}">
            <v:RegisterTeacherView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TeachersListViewModel}">
            <v:TeachersListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminDashboardViewModel}">
            <v:AdminDashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CoursesAndGroupsViewModel}">
            <v:CoursesAndGroupsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AttendanceViewModel}">
            <v:AttendanceView />
        </DataTemplate>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <!-- Main Container with Background Mesh -->
    <Border CornerRadius="16" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F172A" Offset="0.0"/>
                <GradientStop Color="#1E293B" Offset="0.5"/>
                <GradientStop Color="#020617" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
        
        <!-- Abstract Glass Orbs (Mesh Simulation) - Optimized with RadialGradientBrush -->
        <Grid>
            <!-- Blue Glow -->
            <Ellipse Width="600" Height="600" Margin="-200,-200,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#403B82F6" Offset="0.0" />
                        <GradientStop Color="#003B82F6" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            
            <!-- Green Glow -->
            <Ellipse Width="500" Height="500" Margin="0,0,-150,-150" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#4010B981" Offset="0.0" />
                        <GradientStop Color="#0010B981" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
        
        <!-- Top Navigation Header with Physical Elevation & Depth -->
        <Border Grid.Row="0" 
                CornerRadius="0,0,16,16"
                Margin="0,0,0,10"
                Padding="24,14">
            <Border.Background>
                <SolidColorBrush Color="#0F172A" Opacity="0.65"/>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#40FFFFFF" Offset="0.0" />
                    <GradientStop Color="#05FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.BorderThickness>0,0,0,1.5</Border.BorderThickness>
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.3" Direction="270" Color="Black" RenderingBias="Performance" />
            </Border.Effect>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation Header (Scrollable horizontally) -->
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center" Margin="0,0,20,0" Padding="0,0,0,5">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="10" Height="10" 
                                CornerRadius="999" 
                                Background="{DynamicResource AccentPrimaryBrush}" 
                                Margin="0,0,12,0" 
                                VerticalAlignment="Center"/>
                        <TextBlock Text="المركز التعليمي" 
                                   Style="{DynamicResource TitleTextStyle}" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,32,0"/>
                        
                        <!-- قسم إدارة الطلاب -->
                        <Button Content="قائمة الطلاب" 
                                Command="{Binding NavigateToStudentsListCommand}" 
                                Visibility="{Binding CanViewStudents, Converter={StaticResource BoolToVisConverter}}"
                                Style="{DynamicResource NavTabButtonStyle}"/>
                        <Button Content="إضافة طالب جديد" 
                                Command="{Binding NavigateToRegisterCommand}" 
                                Visibility="{Binding CanRegisterStudent, Converter={StaticResource BoolToVisConverter}}"
                                Style="{DynamicResource NavTabButtonStyle}"/>

                        <Separator Width="1" Height="22" 
                                   Background="{DynamicResource BorderSubtleBrush}" 
                                   Margin="12,0,20,0"/>

                        <!-- قسم إدارة المعلمين -->
                        <Button Content="قائمة المعلمين" 
                                Command="{Binding NavigateToTeachersListCommand}" 
                                Visibility="{Binding CanViewTeachers, Converter={StaticResource BoolToVisConverter}}"
                                Style="{DynamicResource NavTabButtonStyle}"/>
                        <Button Content="إضافة معلم جديد" 
                                Command="{Binding NavigateToRegisterTeacherCommand}" 
                                Visibility="{Binding CanRegisterTeacher, Converter={StaticResource BoolToVisConverter}}"
                                Style="{DynamicResource NavTabButtonStyle}"/>

                        <Separator Width="1" Height="22" 
                                   Background="{DynamicResource BorderSubtleBrush}" 
                                   Margin="12,0,20,0"/>

                        <!-- قسم لوحة تحكم الإدارة والأدوار -->
                        <Button Content="لوحة الإدارة" 
                                Command="{Binding NavigateToAdminDashboardCommand}" 
                                Visibility="{Binding CanManageRolesOrUsers, Converter={StaticResource BoolToVisConverter}}"
                                Style="{DynamicResource NavTabButtonStyle}"/>
                                
                        <!-- قسم المجموعات والمواد -->
                        <Button Content="المجموعات والمواد" 
                                Command="{Binding NavigateToCoursesAndGroupsCommand}" 
                                Visibility="{Binding CanManageCourses, Converter={StaticResource BoolToVisConverter}}"
                                Style="{DynamicResource NavTabButtonStyle}"/>

                        <Separator Width="1" Height="22" 
                                   Background="{DynamicResource BorderSubtleBrush}" 
                                   Margin="12,0,20,0"/>

                        <!-- قسم الحضور والغياب -->
                        <Button Content="الحضور والغياب" 
                                Command="{Binding NavigateToAttendanceCommand}" 
                                Visibility="{Binding CanManageCourses, Converter={StaticResource BoolToVisConverter}}"
                                Style="{DynamicResource NavTabButtonStyle}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Current User & System Status (Right side) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- User Profile Chip -->
                    <Border Background="{DynamicResource SurfaceHoverBrush}" 
                            CornerRadius="8" 
                            Padding="10,4" 
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUserName}" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                       FontSize="12" 
                                       FontWeight="SemiBold" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,8,0"/>
                            <Border Background="{DynamicResource AccentPrimaryBrush}" 
                                    CornerRadius="4" 
                                    Padding="6,2">
                                <TextBlock Text="{Binding CurrentUserRole}" 
                                           Foreground="White" 
                                           FontSize="10" 
                                           FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Status Chip -->
                    <Border Background="{DynamicResource StatusSuccessBackgroundBrush}" 
                            BorderBrush="{DynamicResource StatusSuccessBrush}" 
                            BorderThickness="1" 
                            CornerRadius="999" 
                            Padding="12,4">
                        <TextBlock Text="النظام متصل" 
                                   Foreground="{DynamicResource StatusSuccessBrush}" 
                                   FontSize="12" 
                                   FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- View Display Area -->
        <Border Grid.Row="1" Margin="16" 
                CornerRadius="16" BorderThickness="1.5">
            <Border.Background>
                <SolidColorBrush Color="#0F172A" Opacity="0.55"/>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#30FFFFFF" Offset="0.0" />
                    <GradientStop Color="#05FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.25" Direction="270" Color="Black" RenderingBias="Performance" />
            </Border.Effect>

            <ContentControl Content="{Binding CurrentViewModel}" Margin="16"/>
        </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
