<UserControl x:Class="EducationCenterSystem.Presentation.Views.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:EducationCenterSystem.Presentation.ViewModels"
             xmlns:m="clr-namespace:EducationCenterSystem.Presentation.Models"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=vm:AdminDashboardViewModel, IsDesignTimeCreatable=False}"
             FlowDirection="RightToLeft"
             Background="{DynamicResource SurfaceAppBackgroundBrush}">

    <UserControl.Resources>
        <!-- Tab visibility helper styles based on SelectedTabIndex -->
        <Style x:Key="RolesTabVisibilityStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="UsersTabVisibilityStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Tab0ButtonStyle" TargetType="Button" BasedOn="{StaticResource NavTabButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="0">
                    <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Tab1ButtonStyle" TargetType="Button" BasedOn="{StaticResource NavTabButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTabIndex}" Value="1">
                    <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0: Header & Stats Ribbon -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Navigation Tabs Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Main Dynamic Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- ROW 0: HEADER & STATS METRICS RIBBON       -->
        <!-- ========================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title & Subtitle -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="24" 
                            Background="{DynamicResource AccentPrimaryBrush}" 
                            CornerRadius="4" 
                            Margin="0,0,12,0"/>
                    <TextBlock Text="لوحة تحكم الإدارة والأدوار" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <TextBlock Text="إدارة شاملة لصلاحيات النظام، تعريف الأدوار، والتحكم بحسابات المستخدمين وتراخيص الوصول." 
                           FontSize="13" 
                           Foreground="{DynamicResource TextSecondaryBrush}" 
                           Margin="20,4,0,0"/>
            </StackPanel>

            <!-- Stats Ribbon (4 Metric Cards) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Stat 1: Total Users -->
                <Border Background="{DynamicResource SurfaceCardBrush}" 
                        BorderBrush="{DynamicResource BorderSubtleBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="14,8" 
                        Margin="0,0,10,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="المستخدمين" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalUsersCount}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Stat 2: Active Users -->
                <Border Background="{DynamicResource SurfaceCardBrush}" 
                        BorderBrush="{DynamicResource BorderSubtleBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="14,8" 
                        Margin="0,0,10,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="حسابات نشطة" FontSize="11" Foreground="{DynamicResource StatusSuccessBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ActiveUsersCount}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource StatusSuccessBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Stat 3: Roles Count -->
                <Border Background="{DynamicResource SurfaceCardBrush}" 
                        BorderBrush="{DynamicResource BorderSubtleBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="14,8" 
                        Margin="0,0,10,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="الأدوار المعرّفة" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalRolesCount}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Stat 4: Permissions Count -->
                <Border Background="{DynamicResource SurfaceCardBrush}" 
                        BorderBrush="{DynamicResource BorderSubtleBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="14,8">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="صلاحيات النظام" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalPermissionsCount}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ========================================== -->
        <!-- ROW 1: NAVIGATION TABS BAR                -->
        <!-- ========================================== -->
        <Border Grid.Row="1" 
                Background="{DynamicResource SurfaceCardBrush}" 
                BorderBrush="{DynamicResource BorderSubtleBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="8" 
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="الأدوار والصلاحيات (Roles &amp; Permissions)" 
                            Command="{Binding SwitchTabCommand}" 
                            CommandParameter="0" 
                            Style="{StaticResource Tab0ButtonStyle}" 
                            Padding="20,8"/>
                    <Button Content="المستخدمين وحسابات النظام (Users Management)" 
                            Command="{Binding SwitchTabCommand}" 
                            CommandParameter="1" 
                            Style="{StaticResource Tab1ButtonStyle}" 
                            Padding="20,8"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="تحديث البيانات ⟳" 
                            Command="{Binding LoadInitialDataCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Height="34" 
                            Padding="14,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- ROW 2: MAIN CONTENT - TAB 0: ROLES         -->
        <!-- ========================================== -->
        <Grid Grid.Row="2" Style="{StaticResource RolesTabVisibilityStyle}">
            <Grid.ColumnDefinitions>
                <!-- Left: Roles Catalog & Preview (40%) -->
                <ColumnDefinition Width="420"/>
                <!-- Splitter/Gap -->
                <ColumnDefinition Width="16"/>
                <!-- Right: Create Role Form & Permissions Matrix (60%) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: ROLES LIST & DETAILS -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource SurfaceCardBrush}" 
                    BorderBrush="{DynamicResource BorderSubtleBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Roles Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="الأدوار المتوفرة بالنظام" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="1" 
                                Background="{DynamicResource SurfaceHoverBrush}" 
                                CornerRadius="12" 
                                Padding="8,2">
                            <TextBlock Text="{Binding Roles.Count, StringFormat='{}{0} أدوار'}" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </Grid>

                    <!-- Roles ListBox -->
                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding Roles}" 
                             SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                             Background="Transparent" 
                             BorderThickness="0" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemBorder" 
                                                    Background="{DynamicResource SurfaceAppBackgroundBrush}" 
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="6" 
                                                    Padding="12,10" 
                                                    Cursor="Hand">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:RoleModel}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Role Header: Name & Badge -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" 
                                                   FontSize="14" 
                                                   FontWeight="Bold" 
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Grid.Column="1" 
                                                CornerRadius="4" 
                                                Padding="6,2"
                                                Background="{DynamicResource SurfaceCardHoverBrush}">
                                            <TextBlock Text="{Binding RoleTypeBadge}" 
                                                       FontSize="10" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                        </Border>
                                    </Grid>

                                    <!-- Description -->
                                    <TextBlock Grid.Row="1" 
                                               Text="{Binding Description}" 
                                               FontSize="12" 
                                               Foreground="{DynamicResource TextSecondaryBrush}" 
                                               TextWrapping="Wrap" 
                                               Margin="0,4,0,6"/>

                                    <!-- Footer info: Permissions count -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <Border Background="{DynamicResource SurfaceHoverBrush}" 
                                                CornerRadius="4" 
                                                Padding="6,2">
                                            <TextBlock Text="{Binding PermissionsSummary}" 
                                                       FontSize="11" 
                                                       Foreground="{DynamicResource StatusSuccessBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Selected Role Permissions Inspector (Bottom Details) -->
                    <Border Grid.Row="2" 
                            Background="{DynamicResource SurfaceAppBackgroundBrush}" 
                            BorderBrush="{DynamicResource BorderSubtleBrush}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="12" 
                            Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedRole.Name, StringFormat='الصلاحيات الممنوحة لدور: {0}'}" 
                                       FontSize="12" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                       Margin="0,0,0,6"/>
                            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SelectedRole.Permissions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource SurfaceCardHoverBrush}" 
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="4" 
                                                    Padding="6,2" 
                                                    Margin="2">
                                                <TextBlock Text="{Binding}" 
                                                           FontSize="11" 
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: CREATE ROLE FORM & PERMISSIONS MATRIX -->
            <Border Grid.Column="2" 
                    Background="{DynamicResource SurfaceCardBrush}" 
                    BorderBrush="{DynamicResource BorderSubtleBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Form Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Role Inputs (Name, Description) -->
                        <RowDefinition Height="Auto"/>
                        <!-- Permissions Toolbar (Select all, Clear, Module filters) -->
                        <RowDefinition Height="Auto"/>
                        <!-- Permissions Matrix List -->
                        <RowDefinition Height="*"/>
                        <!-- Save Button -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Form Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="إنشاء دور مخصص جديد وتعيين الصلاحيات" 
                                       FontSize="16" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="حدد اسماً معبراً للدور واختر الصلاحيات الممنوحة بدقة وفق مصفوفة الأذونات." 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" 
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Role Inputs -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Role Name -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="اسم الدور *" 
                                       FontSize="12" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                       Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewRoleName, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBoxStyle}" 
                                     Height="36"/>
                        </StackPanel>

                        <!-- Role Description -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="وصف الدور والمهام" 
                                       FontSize="12" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                       Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewRoleDescription, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernTextBoxStyle}" 
                                     Height="36"/>
                        </StackPanel>
                    </Grid>

                    <!-- Permissions Toolbar -->
                    <Border Grid.Row="2" 
                            Background="{DynamicResource SurfaceAppBackgroundBrush}" 
                            BorderBrush="{DynamicResource BorderSubtleBrush}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="10,6" 
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Text="مصفوفة الصلاحيات المتاحة:" 
                                       FontSize="13" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                       VerticalAlignment="Center"/>

                            <!-- Quick Module Toggles -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Content="الطلاب" Command="{Binding ToggleModulePermissionsCommand}" CommandParameter="Students" Style="{StaticResource SecondaryButtonStyle}" Height="28" Padding="8,2" Margin="2,0"/>
                                <Button Content="المعلمين" Command="{Binding ToggleModulePermissionsCommand}" CommandParameter="Teachers" Style="{StaticResource SecondaryButtonStyle}" Height="28" Padding="8,2" Margin="2,0"/>
                                <Button Content="الحضور" Command="{Binding ToggleModulePermissionsCommand}" CommandParameter="Attendance" Style="{StaticResource SecondaryButtonStyle}" Height="28" Padding="8,2" Margin="2,0"/>
                                <Button Content="المالية" Command="{Binding ToggleModulePermissionsCommand}" CommandParameter="Finance" Style="{StaticResource SecondaryButtonStyle}" Height="28" Padding="8,2" Margin="2,0"/>
                                <Button Content="المستخدمين" Command="{Binding ToggleModulePermissionsCommand}" CommandParameter="Users" Style="{StaticResource SecondaryButtonStyle}" Height="28" Padding="8,2" Margin="2,0"/>
                                <Button Content="الأدوار" Command="{Binding ToggleModulePermissionsCommand}" CommandParameter="Roles" Style="{StaticResource SecondaryButtonStyle}" Height="28" Padding="8,2" Margin="2,0"/>
                            </StackPanel>

                            <!-- Global Select / Clear -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="تحديد الكل ✓" Command="{Binding SelectAllPermissionsCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="28" Padding="10,2" Margin="0,0,6,0"/>
                                <Button Content="إلغاء التحديد ✕" Command="{Binding ClearAllPermissionsCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="28" Padding="10,2"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Permissions Matrix Grid (Scrollable) -->
                    <Border Grid.Row="3" 
                            Background="{DynamicResource SurfaceAppBackgroundBrush}" 
                            BorderBrush="{DynamicResource BorderSubtleBrush}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AvailablePermissions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type m:PermissionItemModel}">
                                        <Border Width="330" 
                                                Background="{DynamicResource SurfaceCardBrush}" 
                                                BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="6" 
                                                Padding="10,8" 
                                                Margin="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- CheckBox -->
                                                <CheckBox Grid.Column="0" 
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                          Style="{StaticResource ModernCheckBoxStyle}" 
                                                          VerticalAlignment="Top" 
                                                          Margin="0,2,8,0"/>

                                                <!-- Text info -->
                                                <StackPanel Grid.Column="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" 
                                                                   Text="{Binding Description}" 
                                                                   FontSize="12" 
                                                                   FontWeight="SemiBold" 
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <Border Grid.Column="1" 
                                                                Background="{DynamicResource SurfaceCardHoverBrush}" 
                                                                CornerRadius="4" 
                                                                Padding="4,1">
                                                            <TextBlock Text="{Binding ModuleDisplayName}" 
                                                                       FontSize="10" 
                                                                       Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Name}" 
                                                               FontSize="10" 
                                                               Foreground="{DynamicResource TextMutedBrush}" 
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Save Button -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                        <Button Content="حفظ وتفعيل الدور الجديد ✓" 
                                Command="{Binding CreateRoleCommand}" 
                                Style="{StaticResource PrimaryButtonStyle}" 
                                Height="38" 
                                Padding="24,8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- ROW 2: MAIN CONTENT - TAB 1: USERS         -->
        <!-- ========================================== -->
        <Grid Grid.Row="2" Style="{StaticResource UsersTabVisibilityStyle}">
            <Grid.RowDefinitions>
                <!-- Top Toolbar & Search -->
                <RowDefinition Height="Auto"/>
                <!-- Add User Collapsible Card -->
                <RowDefinition Height="Auto"/>
                <!-- Users DataGrid -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Users Toolbar -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource SurfaceCardBrush}" 
                    BorderBrush="{DynamicResource BorderSubtleBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="12,10" 
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <TextBox Grid.Column="0" 
                             Text="{Binding UserSearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBoxStyle}" 
                             Height="34" 
                             Padding="10,4"
                             Tag="ابحث بالاسم أو البريد أو الدور..."/>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="إضافة حساب مستخدم جديد +" 
                                Command="{Binding ToggleCreateUserSectionCommand}" 
                                Style="{StaticResource PrimaryButtonStyle}" 
                                Height="34" 
                                Padding="16,6" 
                                Margin="0,0,8,0"/>
                        <Button Content="تحديث القائمة ⟳" 
                                Command="{Binding RefreshUsersCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}" 
                                Height="34" 
                                Padding="14,6"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Collapsible Add User Card -->
            <Border Grid.Row="1" 
                    Background="{DynamicResource SurfaceCardBrush}" 
                    BorderBrush="{DynamicResource AccentPrimaryBrush}" 
                    BorderThickness="1.5" 
                    CornerRadius="8" 
                    Padding="16" 
                    Margin="0,0,0,12"
                    Visibility="{Binding IsCreateUserSectionOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="تسجيل مستخدم جديد وتعيين الدور المبدئي" 
                               FontSize="15" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" 
                               Margin="0,0,0,12"/>

                    <!-- User Fields Grid (3 columns) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- First Name -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                            <TextBlock Text="الاسم الأول *" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewUserFirstName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="34"/>
                        </StackPanel>

                        <!-- Last Name -->
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                            <TextBlock Text="الاسم الأخير *" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewUserLastName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="34"/>
                        </StackPanel>

                        <!-- Email -->
                        <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,10">
                            <TextBlock Text="البريد الإلكتروني *" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewUserEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="34"/>
                        </StackPanel>

                        <!-- Password -->
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="كلمة المرور *" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewUserPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="34"/>
                        </StackPanel>

                        <!-- Phone -->
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="رقم الهاتف" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewUserPhoneNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="34"/>
                        </StackPanel>

                        <!-- Role Selection -->
                        <StackPanel Grid.Row="1" Grid.Column="4">
                            <TextBlock Text="الدور المبدئي" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Roles}" 
                                      SelectedItem="{Binding NewUserSelectedRole, Mode=TwoWay}" 
                                      DisplayMemberPath="Name" 
                                      Style="{StaticResource ModernComboBoxStyle}" 
                                      Height="34"/>
                        </StackPanel>
                    </Grid>

                    <!-- Save & Cancel Action buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="تأكيد إنشاء الحساب ✓" 
                                Command="{Binding CreateUserCommand}" 
                                Style="{StaticResource SuccessButtonStyle}" 
                                Height="34" 
                                Padding="20,6" 
                                Margin="0,0,8,0"/>
                        <Button Content="إلغاء ✕" 
                                Command="{Binding ToggleCreateUserSectionCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}" 
                                Height="34" 
                                Padding="16,6"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Users DataGrid -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource SurfaceCardBrush}" 
                    BorderBrush="{DynamicResource BorderSubtleBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="4">
                <DataGrid ItemsSource="{Binding FilteredUsers}" 
                          SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          SelectionMode="Single" 
                          HeadersVisibility="Column" 
                          GridLinesVisibility="Horizontal" 
                          HorizontalGridLinesBrush="{DynamicResource BorderSubtleBrush}" 
                          BorderThickness="0" 
                          RowHeight="42" 
                          FontSize="13" 
                          Background="{DynamicResource SurfaceCardBrush}" 
                          Foreground="{DynamicResource TextPrimaryBrush}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource SurfaceAppBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <!-- Name -->
                        <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="180"/>
                        
                        <!-- Email -->
                        <DataGridTextColumn Header="البريد الإلكتروني" Binding="{Binding Email}" Width="220"/>
                        
                        <!-- Phone -->
                        <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding DisplayPhone}" Width="130"/>
                        
                        <!-- Primary Role Badge -->
                        <DataGridTemplateColumn Header="الدور الحالي" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type m:UserModel}">
                                    <Border Background="{DynamicResource SurfaceCardHoverBrush}" 
                                            CornerRadius="4" 
                                            Padding="8,3" 
                                            HorizontalAlignment="Left" 
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PrimaryRole}" 
                                                   FontSize="11" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status Badge -->
                        <DataGridTemplateColumn Header="الحالة" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type m:UserModel}">
                                    <Border CornerRadius="4" 
                                            Padding="8,3" 
                                            HorizontalAlignment="Left" 
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource StatusSuccessBackgroundBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Background" Value="{DynamicResource StatusDangerBackgroundBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusBadge}" 
                                                   FontSize="11" 
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource StatusDangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Created At -->
                        <DataGridTextColumn Header="تاريخ التسجيل" Binding="{Binding CreatedAtFormatted}" Width="140"/>

                        <!-- Last Login -->
                        <DataGridTextColumn Header="آخر تسجيل دخول" Binding="{Binding LastLoginFormatted}" Width="140"/>

                        <!-- Action: Assign Role Button -->
                        <DataGridTemplateColumn Header="إجراءات" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type m:UserModel}">
                                    <Button Content="تغيير الدور" 
                                            Command="{Binding DataContext.OpenAssignRoleDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}" 
                                            Style="{StaticResource SecondaryButtonStyle}" 
                                            Height="28" 
                                            Padding="10,2" 
                                            HorizontalAlignment="Left" 
                                            VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- ASSIGN ROLE POPUP / MODAL OVERLAY         -->
        <!-- ========================================== -->
        <Border Grid.Row="0" Grid.RowSpan="3" 
                Background="#990F172A" 
                Visibility="{Binding IsAssignRoleDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="100">
            <Border Background="{DynamicResource SurfaceCardBrush}" 
                    BorderBrush="{DynamicResource BorderFocusBrush}" 
                    BorderThickness="1.5" 
                    CornerRadius="12" 
                    Padding="24" 
                    Width="450" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="تغيير وتعيين دور المستخدم" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" 
                               Margin="0,0,0,8"/>
                    
                    <TextBlock Text="{Binding UserToAssignRole.FullName, StringFormat='المستخدم: {0}'}" 
                               FontSize="14" 
                               Foreground="{DynamicResource AccentPrimaryBrush}" 
                               Margin="0,0,0,4"/>

                    <TextBlock Text="{Binding UserToAssignRole.Email, StringFormat='البريد: {0}'}" 
                               FontSize="12" 
                               Foreground="{DynamicResource TextSecondaryBrush}" 
                               Margin="0,0,0,16"/>

                    <TextBlock Text="اختر الدور الجديد للمستخدم:" 
                               FontSize="13" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" 
                               Margin="0,0,0,6"/>

                    <ComboBox ItemsSource="{Binding Roles}" 
                              SelectedItem="{Binding RoleToAssign, Mode=TwoWay}" 
                              DisplayMemberPath="Name" 
                              Style="{StaticResource ModernComboBoxStyle}" 
                              Height="36" 
                              Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="تأكيد التعيين ✓" 
                                Command="{Binding ConfirmAssignRoleCommand}" 
                                Style="{StaticResource PrimaryButtonStyle}" 
                                Height="36" 
                                Padding="20,6" 
                                Margin="0,0,8,0"/>
                        <Button Content="إلغاء ✕" 
                                Command="{Binding CloseAssignRoleDialogCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}" 
                                Height="36" 
                                Padding="16,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ========================================== -->
        <!-- LOADING OVERLAY                            -->
        <!-- ========================================== -->
        <Border Grid.Row="0" Grid.RowSpan="3" 
                Background="#880F172A" 
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="150">
            <Border Background="{DynamicResource SurfaceCardBrush}" 
                    BorderBrush="{DynamicResource BorderSubtleBrush}" 
                    BorderThickness="1" 
                    CornerRadius="10" 
                    Padding="24,16" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="24" Height="24" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding BusyMessage}" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource AccentPrimaryBrush}" 
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
