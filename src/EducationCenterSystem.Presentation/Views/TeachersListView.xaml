<UserControl x:Class="EducationCenterSystem.Presentation.Views.TeachersListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:EducationCenterSystem.Presentation.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance Type=vm:TeachersListViewModel, IsDesignTimeCreatable=False}"
             FlowDirection="RightToLeft"
             Background="#F8F9FA">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#D0D7DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="قائمة المعلمين" FontSize="26" FontWeight="Bold" Foreground="#1F2937"/>
                <TextBlock Text="{Binding PageSummaryText}" FontSize="13" Foreground="#6B7280" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="عرض بالصفحة:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" Foreground="#374151"/>
                <ComboBox ItemsSource="{Binding PageSizeOptions}" 
                          SelectedItem="{Binding PageSize, Mode=TwoWay}"
                          Width="70" Height="32" 
                          VerticalContentAlignment="Center" 
                          Padding="8,2"
                          FontSize="13"/>
            </StackPanel>
        </Grid>

        <!-- DataGrid (Fits height, virtualized) -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" BorderBrush="#E5E7EB" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Teachers}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F3F4F6"
                      BorderThickness="0"
                      RowHeight="38"
                      FontSize="13"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      Background="White">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu FlowDirection="RightToLeft">
                                    <MenuItem Header="تعديل بيانات المعلم" 
                                              Command="{Binding PlacementTarget.Tag.EditTeacherCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              CommandParameter="{Binding}" />
                                    <Separator />
                                    <MenuItem Header="حذف معلم" 
                                              Foreground="#DC3545"
                                              FontWeight="SemiBold"
                                              Command="{Binding PlacementTarget.Tag.DeleteTeacherCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="م" Binding="{Binding SerialNumber}" Width="60"/>
                    <DataGridTextColumn Header="كود المعلم" Binding="{Binding TeacherCode}" Width="110"/>
                    <DataGridTextColumn Header="الاسم الأول" Binding="{Binding FirstName}" Width="130"/>
                    <DataGridTextColumn Header="الاسم الأخير" Binding="{Binding LastName}" Width="130"/>
                    <DataGridTextColumn Header="المادة التخصصية" Binding="{Binding Subject}" Width="150"/>
                    <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding PhoneNumber}" Width="130"/>
                    <DataGridTextColumn Header="الرقم القومي" Binding="{Binding NationalId}" Width="140"/>
                    <DataGridTextColumn Header="المؤهل الدراسي" Binding="{Binding Qualification}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Pagination Toolbar (Bottom Bar) -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,12,0,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="« الأولى" Command="{Binding FirstPageCommand}" IsEnabled="{Binding HasPreviousPage}" Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="‹ السابقة" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding HasPreviousPage}" Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="التالية ›" Command="{Binding NextPageCommand}" IsEnabled="{Binding HasNextPage}" Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="الأخيرة »" Command="{Binding LastPageCommand}" IsEnabled="{Binding HasNextPage}" Style="{StaticResource NavButtonStyle}"/>
                </StackPanel>

                <!-- Summary Status Badge -->
                <TextBlock Grid.Column="1" 
                           Text="{Binding PageSummaryText}" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           FontSize="13" 
                           FontWeight="SemiBold" 
                           Foreground="#4B5563"/>

                <!-- Jump to Specific Page Input -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="انتقل لصفحة:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13" Foreground="#374151"/>
                    <TextBox Text="{Binding TargetPageInput, UpdateSourceTrigger=PropertyChanged}" 
                             Width="65" Height="30" 
                             VerticalContentAlignment="Center" 
                             HorizontalContentAlignment="Center"
                             FontSize="13" 
                             Margin="0,0,6,0"/>
                    <Button Content="انتقال" Command="{Binding JumpToPageCommand}" Style="{StaticResource NavButtonStyle}" Background="#0066CC" Foreground="White" BorderBrush="#0055AA"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.Row="1" Background="#66FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" CornerRadius="8" Padding="20,12" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#E5E7EB" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar IsIndeterminate="True" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="جاري تحميل الصفحة..." FontSize="14" FontWeight="Bold" Foreground="#0066CC" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
