<UserControl x:Class="EducationCenterSystem.Presentation.Views.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:components="clr-namespace:EducationCenterSystem.Presentation.Views.Components"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{DynamicResource SurfaceAppBackgroundBrush}"
             TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="نظام الحضور والغياب" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Groups and Sessions -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="اختر المجموعة" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ComboBox Grid.Row="1" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" 
                              DisplayMemberPath="Name" Margin="0,0,0,20" />

                    <Separator Grid.Row="2" Margin="0,0,0,20"/>

                    <StackPanel Grid.Row="3" Margin="0,0,0,20">
                        <TextBlock Text="إنشاء حصة جديدة" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <DatePicker SelectedDate="{Binding NewSessionDate}" Margin="0,0,0,10"/>
                        <TextBox Text="{Binding NewSessionNotes}" Margin="0,0,0,10"/>
                        <Button Content="إنشاء حصة" Command="{Binding CreateSessionCommand}" />
                    </StackPanel>

                    <TextBlock Grid.Row="4" Text="الحصص السابقة" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" VerticalAlignment="Top"/>
                    <ListBox Grid.Row="4" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" Margin="0,35,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding SessionDate, StringFormat=yyyy-MM-dd}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Notes}" FontStyle="Italic" Foreground="Gray"/>
                                    <TextBlock Text="{Binding TotalAttendees, StringFormat=الحضور: {0}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right Panel: Attendance List -->
            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="سجل الحضور للحصة المحددة" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
                    
                    <DataGrid Grid.Row="1" ItemsSource="{Binding AttendanceRecords}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم الطالب" Binding="{Binding StudentName}" Width="*"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="150"/>
                            <DataGridTextColumn Header="الملاحظات" Binding="{Binding Notes}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <!-- If no session selected -->
                    <TextBlock Grid.Row="1" Text="يرجى تحديد حصة لعرض سجل الحضور." 
                               HorizontalAlignment="Center" VerticalAlignment="Center" 
                               FontSize="16" Foreground="Gray">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSession}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
