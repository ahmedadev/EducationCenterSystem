<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Corner Radii -->
    <CornerRadius x:Key="RadiusSmall" TopLeft="6" TopRight="6" BottomRight="6" BottomLeft="6"/>
    <CornerRadius x:Key="RadiusMedium" TopLeft="10" TopRight="10" BottomRight="10" BottomLeft="10"/>
    <CornerRadius x:Key="RadiusLarge" TopLeft="16" TopRight="16" BottomRight="16" BottomLeft="16"/>
    <CornerRadius x:Key="RadiusFull" TopLeft="999" TopRight="999" BottomRight="999" BottomLeft="999"/>

    <!-- Standard Margins / Paddings -->
    <Thickness x:Key="PaddingSmall" Left="8" Top="6" Right="8" Bottom="6"/>
    <Thickness x:Key="PaddingMedium" Left="14" Top="10" Right="14" Bottom="10"/>
    <Thickness x:Key="PaddingLarge" Left="20" Top="16" Right="20" Bottom="16"/>
    <Thickness x:Key="PaddingCard" Left="24" Top="24" Right="24" Bottom="24"/>

    <!-- Standard Heights -->
    <sys:Double x:Key="InputHeight">40</sys:Double>
    <sys:Double x:Key="ButtonHeight">40</sys:Double>
    <sys:Double x:Key="RowHeight">42</sys:Double>

</ResourceDictionary>
