<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Neutral Surfaces (60% Rule: Modern Slate/Zinc Foundation) -->
    <Color x:Key="SurfaceAppBackgroundColor">#0F172A</Color>
    <SolidColorBrush x:Key="SurfaceAppBackgroundBrush" Color="{StaticResource SurfaceAppBackgroundColor}"/>

    <Color x:Key="SurfaceCardColor">#1E293B</Color>
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCardColor}"/>

    <Color x:Key="SurfaceCardHoverColor">#283548</Color>
    <SolidColorBrush x:Key="SurfaceCardHoverBrush" Color="{StaticResource SurfaceCardHoverColor}"/>

    <Color x:Key="SurfaceHeaderColor">#0F172A</Color>
    <SolidColorBrush x:Key="SurfaceHeaderBrush" Color="{StaticResource SurfaceHeaderColor}"/>

    <!-- Structural Hierarchy & Borders (30% Rule) -->
    <Color x:Key="BorderSubtleColor">#334155</Color>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}"/>

    <Color x:Key="BorderFocusColor">#38BDF8</Color>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}"/>

    <!-- Purposeful Accent (10% Rule: Precision Cyan/Sky Accent) -->
    <Color x:Key="AccentPrimaryColor">#0284C7</Color>
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimaryColor}"/>

    <Color x:Key="AccentPrimaryHoverColor">#0369A1</Color>
    <SolidColorBrush x:Key="AccentPrimaryHoverBrush" Color="{StaticResource AccentPrimaryHoverColor}"/>

    <Color x:Key="AccentPrimaryPressedColor">#075985</Color>
    <SolidColorBrush x:Key="AccentPrimaryPressedBrush" Color="{StaticResource AccentPrimaryPressedColor}"/>

    <!-- Typography Brushes -->
    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>

    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>

    <Color x:Key="TextMutedColor">#64748B</Color>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>

    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}"/>

    <!-- Status & Feedback Semantic Colors -->
    <Color x:Key="StatusSuccessColor">#10B981</Color>
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccessColor}"/>
    <SolidColorBrush x:Key="StatusSuccessBackgroundBrush" Color="#1E3A2F"/>

    <Color x:Key="StatusWarningColor">#F59E0B</Color>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}"/>
    <SolidColorBrush x:Key="StatusWarningBackgroundBrush" Color="#3D2E14"/>

    <Color x:Key="StatusDangerColor">#EF4444</Color>
    <SolidColorBrush x:Key="StatusDangerBrush" Color="{StaticResource StatusDangerColor}"/>
    <SolidColorBrush x:Key="StatusDangerBackgroundBrush" Color="#3F1E22"/>

</ResourceDictionary>
